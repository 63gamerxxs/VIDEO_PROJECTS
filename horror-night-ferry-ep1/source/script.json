  "lines": [
    {"id":"L01","t0":0.2,"t1":2.8,"who":"pa","fx":"pa","text":"Passenger Dana Reyes. Please return to your seat."},
    {"id":"L02","t0":3.9,"t1":5.3,"who":"hero","fx":"none","text":"I'm not even aboard."},
    {"id":"L03","t0":6.0,"t1":7.6,"who":"npc","fx":"room","text":"Dana! Get aboard. Now!"},
    {"id":"L04","t0":8.2,"t1":9.6,"who":"npc","fx":"room","text":"Walk. Don't stop."},
    {"id":"L05","t0":10.2,"t1":11.9,"who":"hero","fx":"none","text":"How does he know my name?"},
    {"id":"L06","t0":12.6,"t1":13.9,"who":"npc","fx":"room","text":"Hear that engine?"},
    {"id":"L07","t0":14.2,"t1":16.4,"who":"npc","fx":"room","text":"It moves when it goes quiet."},
    {"id":"L08","t0":17.0,"t1":20.2,"who":"pa","fx":"pa","text":"Passenger Marcus Webb. Please return to your seat."},
    {"id":"L09","t0":20.8,"t1":22.6,"who":"hero","fx":"none","text":"Nobody boarded with that name."},
    {"id":"L10","t0":23.0,"t1":26.0,"who":"npc","fx":"room","text":"Whoever it calls, sits down below."},
    {"id":"L11","t0":26.4,"t1":27.3,"who":"hero","fx":"none","text":"And then?"},
    {"id":"L12","t0":27.6,"t1":29.2,"who":"npc","fx":"room","text":"They don't come up."},
    {"id":"L13","t0":30.0,"t1":31.4,"who":"npc","fx":"room","text":"Engine room. Go! Go!"},
    {"id":"L14","t0":33.5,"t1":35.3,"who":"hero","fx":"none","text":"Stay near the hum."},
    {"id":"L15","t0":36.5,"t1":37.8,"who":"hero","fx":"none","text":"It's getting quieter."},
    {"id":"L16","t0":38.4,"t1":40.0,"who":"pa","fx":"pa","text":"Passenger Dana Reyes."},
    {"id":"L17","t0":40.4,"t1":41.6,"who":"hero","fx":"none","text":"No. No, no."},
    {"id":"L18","t0":43.5,"t1":44.8,"who":"hero","fx":"whisper","text":"Hide. Don't breathe."},
    {"id":"L19","t0":46.0,"t1":48.3,"who":"pa","fx":"pa","text":"Passenger Dana Reyes. Seat four."},
    {"id":"L20","t0":50.0,"t1":51.6,"who":"hero","fx":"none","text":"Gone. The hum's back."},
    {"id":"L21","t0":58.0,"t1":62.5,"who":"friend","fx":"phone","text":"Dana, it's Captain Osei. Stay on deck. Do not go below."},
    {"id":"L22","t0":63.6,"t1":65.4,"who":"pa","fx":"phone","text":"Proceed below. You are late."},
    {"id":"L23","t0":69.8,"t1":71.5,"who":"hero","fx":"none","text":"That's my dog's name."},
    {"id":"L24","t0":72.0,"t1":73.6,"who":"hero","fx":"none","text":"One of you is lying."},
    {"id":"L25","t0":76.2,"t1":77.6,"who":"threat","fx":"whisper","text":"Dana. Sit."},
    {"id":"L26","t0":78.0,"t1":79.4,"who":"hero","fx":"none","text":"Deck... or below."}
  ],
